{
  "name": "tablemax",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "10.12.1"
  },
  "scripts": {
    "setup:desktop": "node scripts/setup-desktop.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/launch.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "verify:desktop": "node scripts/verify-pokemon.mjs",
    "verify:game-ui": "node scripts/verify-game-ui.mjs",
    "verify:cards": "node scripts/verify-card-layout.mjs",
    "package:win": "node scripts/package.mjs",
    "package:release": "node scripts/package-release.mjs",
    "verify:portable": "node scripts/verify-pokemon.mjs --portable",
    "verify:party": "node scripts/verify-party.mjs",
    "verify:room-levels": "node scripts/verify-room-levels.mjs",
    "verify:presentation": "node scripts/verify-play-presentation.mjs",
    "verify:display": "node scripts/verify-display.mjs",
    "prototype:dev": "vite --config apps/web/vite.prototype.config.ts",
    "prototype:build": "vite build --config apps/web/vite.prototype.config.ts",
    "prototype:preview": "vite preview --config apps/web/vite.prototype.config.ts",
    "prototype:verify": "node scripts/verify-prototype.mjs",
    "prototype:verify:game": "node scripts/verify-game-prototype.mjs",
    "verify:experience": "node scripts/verify-experience.mjs",
    "verify:memory": "node scripts/verify-runtime-memory.mjs",
    "verify:effects": "node scripts/verify-pokemon-effects.mjs",
    "verify:modern-art": "node scripts/verify-modern-art.mjs",
    "verify:power-grid": "node scripts/verify-power-grid.mjs",
    "verify:power-grid-ui": "node scripts/verify-power-grid-ui.mjs",
    "assemble:win": "node scripts/assemble.mjs",
    "release:github": "node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "playwright": "1.63.0",
    "@types/node": "22.14.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
