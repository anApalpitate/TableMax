{
  "folders": [
    {
      "name": "TableMax",
      "path": ".",
    },
  ],
  "extensions": {
    "recommendations": ["esbenp.prettier-vscode", "dbaeumer.vscode-eslint"],
  },
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "explorer.excludeGitIgnore": false,
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/.pnpm-store": true,
      "**/.cache": true,
      "**/.vite": true,
      "build": true,
      "dist": true,
      "tmp": true,
      "**/coverage": true,
      "**/playwright-report": true,
      "**/test-results": true,
      "**/*.log": true,
      "**/*.tmp": true,
      "**/*.swp": true,
      "**/*~": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
    },
    "search.exclude": {
      "artifacts": true,
      "**/.git": true,
      "**/node_modules": true,
      "**/.pnpm-store": true,
      "**/.cache": true,
      "**/.vite": true,
      "build": true,
      "dist": true,
      "tmp": true,
      "**/coverage": true,
      "**/playwright-report": true,
      "**/test-results": true,
      "**/*.log": true,
    },
    "files.watcherExclude": {
      "artifacts/**": true,
      "**/.git/**": true,
      "**/node_modules/**": true,
      "**/.pnpm-store/**": true,
      "**/.cache/**": true,
      "**/.vite/**": true,
      "build/**": true,
      "dist/**": true,
      "tmp/**": true,
      "**/coverage/**": true,
      "**/playwright-report/**": true,
      "**/test-results/**": true,
      "**/*.log": true,
    },
  },
}
