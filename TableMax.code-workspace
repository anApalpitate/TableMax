{
  "folders": [
    {
      "name": "TableMax",
      "path": ".",
    },
  ],
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint"
    ],
  },
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "explorer.excludeGitIgnore": false,
    "files.exclude": {
      ".editorconfig": true,
      ".gitattributes": true,
      ".gitignore": true,
      ".node-version": true,
      ".npmrc": true,
      ".prettierignore": true,
      ".prettierrc.json": true,
      "build-version.json": true,
      "eslint.config.mjs": true,
      "global.json": true,
      "pnpm-lock.yaml": true,
      "pnpm-workspace.yaml": true,
      "tsconfig.json": true,
      "vitest.config.ts": true,
      "**/.git": true,
      "**/node_modules": true,
      "**/.pnpm-store": true,
      "**/.cache": true,
      "**/.vite": true,
      "build": true,
      "dist": true,
      "apps/desktop/native/bin": true,
      "apps/desktop/native/obj": true,
      "tmp": true,
      "**/coverage": true,
      "**/playwright-report": true,
      "**/test-results": true,
      "**/*.log": true,
      "**/*.tmp": true,
      "**/*.swp": true,
      "**/*~": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
    },
    "search.exclude": {
      "artifacts": true,
      "**/.git": true,
      "**/node_modules": true,
      "**/.pnpm-store": true,
      "**/.cache": true,
      "**/.vite": true,
      "build": true,
      "dist": true,
      "apps/desktop/native/bin": true,
      "apps/desktop/native/obj": true,
      "tmp": true,
      "**/coverage": true,
      "**/playwright-report": true,
      "**/test-results": true,
      "**/*.log": true,
    },
    "files.watcherExclude": {
      "artifacts/**": true,
      "**/.git/**": true,
      "**/node_modules/**": true,
      "**/.pnpm-store/**": true,
      "**/.cache/**": true,
      "**/.vite/**": true,
      "build/**": true,
      "dist/**": true,
      "apps/desktop/native/bin/**": true,
      "apps/desktop/native/obj/**": true,
      "tmp/**": true,
      "**/coverage/**": true,
      "**/playwright-report/**": true,
      "**/test-results/**": true,
      "**/*.log": true,
    },
  },
}